{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "idevice",
  "version": "0.1.0",
  "identifier": "dev.idevice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "idevice",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
